% soilproc.sty -- house style for the Proceedings of the International
% Symposium on Soil Health and Sustainable Crop Production.
% Written for this benchmark asset. Compile with pdfLaTeX, biber and makeindex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{soilproc}[2026/09/30 v1.0 Soil Health Proceedings house style]

% ---------------------------------------------------------------- page and fonts
\RequirePackage[a4paper,inner=28mm,outer=24mm,top=28mm,bottom=30mm,headsep=8mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage[british]{babel}
\addto\captionsbritish{\renewcommand{\chaptername}{Paper}}% each chapter is a contributed paper
\RequirePackage{microtype}
\RequirePackage[autostyle]{csquotes}
\setlength{\emergencystretch}{2em}

% ---------------------------------------------------------------- separate papers
% Loaded early so that \subfix is available for file paths below.
\RequirePackage{subfiles}

% ---------------------------------------------------------------- tables, units, figures
\RequirePackage{booktabs}
\RequirePackage{siunitx}
\sisetup{group-minimum-digits=4, detect-all}
\RequirePackage{graphicx}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% ---------------------------------------------------------------- volume metadata
\newcommand*{\volumetitle}{Proceedings of the International Symposium on Soil Health and Sustainable Crop Production}
\newcommand*{\volumeshort}{Soil Health and Sustainable Crop Production}
\newcommand*{\volumenumber}{1}
\newcommand*{\volumeeditor}{Rotimi Alade}

% ---------------------------------------------------------------- running heads
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\itshape \volumeshort}
\fancyhead[RO]{\small\itshape \rightmark}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\chaptermark}[1]{\markboth{#1}{#1}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}
\RequirePackage{emptypage}% pages left blank before a new chapter carry no head or folio

% ---------------------------------------------------------------- bibliography (biber)
\RequirePackage[backend=biber,style=authoryear,maxcitenames=2,uniquename=false,
  uniquelist=false,giveninits=true,useprefix=true,dashed=false,doi=true,url=true,isbn=false]{biblatex}
\addbibresource{\subfix{bib/soilhealth.bib}}
\defbibheading{paperrefs}{\section*{References}}

% ---------------------------------------------------------------- subject index (makeindex)
% noautomatic: makeindex is run as its own build step, so the build is the
% same in TeXstudio, on the command line and in Overleaf.
\RequirePackage[noautomatic]{imakeidx}
\makeindex[title=Subject Index, intoc]

% ---------------------------------------------------------------- links
\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}
\hypersetup{pdftitle={\volumetitle, Volume \volumenumber},
  pdfauthor={\volumeeditor\space (ed.)},
  pdfsubject={Soil health and sustainable crop production}}

% ---------------------------------------------------------------- paper layout
% \begin{paper}{Full title}{Short title for the running head}
%   \begin{paperabstract} ... \end{paperabstract}
%   \paperkeywords{...}
%   ... sections ...
% \end{paper}
% Each paper is one chapter with its own reference section, so its list of
% references contains only the works that paper cites.
\newenvironment{paper}[2]{%
  \chapter{#1}\markboth{#2}{#2}%
  \noindent{\small\itshape Contributed paper}\par\medskip
  \begin{refsection}%
}{%
  \printbibliography[heading=paperrefs]%
  \end{refsection}%
}
\newenvironment{paperabstract}{%
  \begin{quote}\small\noindent\textbf{Abstract.}\ \ignorespaces
}{%
  \end{quote}%
}
\newcommand{\paperkeywords}[1]{%
  \begin{quote}\small\noindent\textbf{Keywords:}\ #1\end{quote}\medskip}

\endinput
